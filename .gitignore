# ============================================================
#  WAI-CAM — .gitignore
# ============================================================

# Documents de travail — exclusions sélectives
# (les PDF/DOCX du projet sont versionnés car le repo est privé)
*.xlsx
*.xls
*.pptx

# Photos terrain (dossier lourd, géré séparément)
PHOTOS ACTIVITES WAIC/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Éditeurs
.vscode/
.idea/
*.swp
*.swo

# Node (si build tools ajoutés plus tard)
node_modules/
npm-debug.log*
yarn-error.log*

# WordPress — fichiers sensibles (si wp-config ajouté un jour)
wp-config.php
wp-config-local.php
.env
.env.local

# Logs
*.log
